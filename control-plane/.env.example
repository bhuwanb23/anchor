# Server
PORT=8080
ENV=development

# JWT
JWT_SECRET=change-this-to-a-random-secret-in-production
JWT_EXPIRY_HOURS=24

# Database
DATABASE_PATH=./data/yourplatform.db

# Agent WebSocket
WS_PATH=/ws/agent

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Public control-plane origin (production / behind TLS proxy e.g. Render).
# When set, install commands and agent websocket_url use this instead of r.Host.
# PUBLIC_BASE_URL=https://anchor-api.onrender.com
# BASE_DOMAIN=anchor-api.onrender.com

# Layer 5C Step 5 — Database backup
# Local: VACUUM INTO snapshot + gzip, every DB_BACKUP_INTERVAL_HOURS (default 6),
# keeping the newest 4 backups in DB_BACKUP_DIR (default: <db-dir>/backups).
DB_BACKUP_DIR=
DB_BACKUP_INTERVAL_HOURS=6

# S3 (optional): when set, an encrypted copy is uploaded every 24h and the
# newest 30 are kept. DB_BACKUP_ENCRYPTION_KEY derives the AES-256 key;
# uploads are skipped (never sent unencrypted) when it is empty.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=
DB_BACKUP_ENCRYPTION_KEY=
